# Example values only. Source real secrets from your runtime secret manager.
#
# The runner reads these with DuckDB's getenv(), so no credential is ever
# written into the generated SQL, onto disk, or onto a command line.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_ROLE=YOUR_ROLE
